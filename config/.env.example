# =============================================================================
# Veteran Wellness Companion Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit the actual .env file to version control.
# =============================================================================

# --- Application ---
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# --- Database ---
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veteran_wellness

# --- Authentication ---
# Generate a secure random string: openssl rand -hex 64
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=7d

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=12

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Logging ---
LOG_LEVEL=debug

# --- Crisis Resources ---
# Veterans Crisis Line: Dial 988 then press 1
# Crisis Text Line: Text 838255
VETERANS_CRISIS_LINE=988
CRISIS_TEXT_LINE=838255