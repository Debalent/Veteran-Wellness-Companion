# =============================================================================
# Veteran Wellness Companion Platform — .gitignore
# =============================================================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.js

# --- Environment ---
.env
.env.local
.env.production

# --- Build Output ---
dist/
build/
*.tsbuildinfo

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editor & IDE ---
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~

# --- OS Files ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Testing ---
coverage/
.nyc_output/

# --- Prisma ---
backend/prisma/*.db
backend/prisma/*.db-journal

# --- Docker ---
docker-compose.override.yml

# --- Python (AI Layer) ---
ai-layer/__pycache__/
ai-layer/*.pyc
ai-layer/.venv/
ai-layer/venv/
ai-layer/.pytest_cache/

# --- Misc ---
*.pem
*.key