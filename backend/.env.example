# =============================================================================
# Backend Environment Variables — copy to .env and fill in real values.
# Never commit a populated .env file.
# =============================================================================

NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/veteran_wellness

# Authentication
JWT_SECRET=replace-with-a-random-64-char-secret
JWT_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Field-level encryption (AES-256-GCM) for PHI/PII at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-a-generated-64-char-hex-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Crisis Resources
VETERANS_CRISIS_LINE=988
CRISIS_TEXT_LINE=838255

# VA Lighthouse API (HL7 FHIR) — optional, only required once integration is enabled
LIGHTHOUSE_API_BASE_URL=https://sandbox-api.va.gov
LIGHTHOUSE_CLIENT_ID=
LIGHTHOUSE_CLIENT_SECRET=
LIGHTHOUSE_TOKEN_URL=https://sandbox-api.va.gov/oauth2/token
